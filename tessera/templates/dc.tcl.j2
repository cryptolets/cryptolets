# Tessera Design Compiler synthesis for {{ kernel }}
date

set_host_options -max_cores {{ max_cores }}

set target_library {{ target_library }}
set link_library {* {{ target_library }} dw_foundation.sldb standard.sldb}
set synthetic_library {dw_foundation.sldb standard.sldb}

set search_path [concat * $search_path]
define_design_lib WORK -path ./work
set_svf {{ module }}.svf

# A broken netlist should error and stop dc
set_message_info -id LINT-61 -stop_on
set_message_info -id UID-3   -stop_on
set_message_info -id RPT-7   -stop_on
set_message_info -id UID-341 -stop_on

{% if children %}
# Children keep their own synthesis, so DC links them instead of flattening.
{% for child in children %}
read_ddc {{ child.ddc }}
{% if child.combinational %}
rename_design {{ child.module }} {{ child.renamed }}
{% else %}
rename_design {{ child.module }} {{ child.renamed_top }}
analyze -library WORK -format sverilog {{ child.wrapper }}
elaborate {{ child.renamed }}
{% endif %}
{% endfor %}
set_dont_touch [get_designs { {{ dont_touch }} }]
{% endif %}

analyze -library WORK -format sverilog {{ rtl }}
elaborate {{ module }}
date
current_design {{ module }}
link

source {{ constraints_tcl }}
{% if combinational %}
set_comb_constraints {{ period }}
{% else %}
set_clocked_constraints {{ period }}
{% endif %}

# Run a full pass first, and then incremental passes for meeting timing
{% for n in range(1, passes + 1) %}
# ---- pass {{ n }} ----
date
{% if n == 1 %}
compile_ultra
{% else %}
compile_ultra -incremental
{% endif %}
date

write_file -hierarchy -format verilog -output {{ dc_dir }}/pass_{{ n }}/{{ kernel }}_gate.v
write_sdc {{ dc_dir }}/pass_{{ n }}/{{ kernel }}_gate.sdc

{% set rpt = report_dir ~ "/pass_" ~ n %}
report_timing -delay max -nosplit -input -nets -cap -max_path 10 -nworst 10 > {{ rpt }}/timing_max.rpt
report_timing -delay min -nosplit -input -nets -cap -max_path 10 -nworst 10 > {{ rpt }}/timing_min.rpt
report_constraint -all_violators -verbose -nosplit                          > {{ rpt }}/constraint.rpt
check_design -nosplit                                                       > {{ rpt }}/check_design.rpt
report_design                                                               > {{ rpt }}/design.rpt
report_area                                                                 > {{ rpt }}/area.rpt
report_area -hierarchy -nosplit                                             > {{ rpt }}/area_hier.rpt
report_timing -loop                                                         > {{ rpt }}/timing_loop.rpt
report_power -hierarchy -analysis_effort high                               > {{ rpt }}/power.rpt
report_qor                                                                  > {{ rpt }}/qor.rpt
report_resources -hierarchy                                                 > {{ rpt }}/resources.rpt
{% endfor %}

# The package carries the last pass, which is what later steps read
write -format ddc     -hierarchy -output {{ syn_dir }}/{{ kernel }}.ddc
write -format verilog -hierarchy -output {{ syn_dir }}/{{ kernel }}_gate.v
write_sdc {{ syn_dir }}/{{ kernel }}_gate.sdc
write_sdf {{ syn_dir }}/{{ kernel }}_gate.sdf

exit
