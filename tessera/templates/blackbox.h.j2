#ifndef _{{ kernel | upper }}_BLACKBOX_H_
#define _{{ kernel | upper }}_BLACKBOX_H_

#if defined(__SYNTHESIS__) && defined(BLACKBOX_FLOW)

#include <ac_int.h>
#include <ac_blackbox.h>
#include "params.h"

// The implementation itself, which a design that was not packaged still uses
#include "{{ impl }}"

{% for d in designs %}
// One packaged design, standing in for the implementation at these arguments
template<>
class {{ kernel }}_impl<{{ d.tmpl_params | map(attribute='value') | join(', ') }}> {
    // The template params under their own names, so run is copied as written
{% for p in d.tmpl_params %}
{% if p.type == "class" %}
    using {{ p.name }} = {{ p.value }};
{% else %}
    static constexpr {{ p.type }} {{ p.name }} = {{ p.value }};
{% endif %}
{% endfor %}

public:
    {{ kernel }}_impl() {}

    #pragma hls_design interface ccore blackbox
    void run(
{% for p in d.ports %}        {{ p }}{{ "," if not loop.last }}
{% endfor %}    ) {
        ac_blackbox()
            .entity("{{ d.module }}")
            .verilog_files("{{ d.rtl }}")
            .outputs("{{ d.outputs | join(' ') }}")
            .area({{ d.area }})
{% if d.combinational %}
            .delay({{ d.delay }})
{% else %}
            .clock_name("clk").latency({{ d.latency }}).init_delay(1)
{% endif %}
            .end();
    }
};
{% endfor %}
#else
#include "{{ impl }}"
#endif

#endif /* _{{ kernel | upper }}_BLACKBOX_H_ */
