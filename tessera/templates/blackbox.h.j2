#ifndef _{{ kernel | upper }}_BLACKBOX_H_
#define _{{ kernel | upper }}_BLACKBOX_H_

#if defined(__SYNTHESIS__) && defined(BLACKBOX_FLOW)

#include <ac_int.h>
#include <ac_blackbox.h>
#include "params.h"

// The implementation itself, which a design that was not packaged still uses
#include "{{ impl }}"

{% for v in variants %}
// One packaged design, standing in for the implementation at these arguments.
// The widths are the ones its RTL was built with.
template<>
class {{ kernel }}_impl<{{ v.args }}> {
public:
    {{ kernel }}_impl() {}

    #pragma hls_design interface ccore blackbox
    void run(
{% for p in v.params %}        {{ p.type }} {{ "&" if p.is_output }}{{ p.name }}{{ "," if not loop.last }}
{% endfor %}    ) {
        ac_blackbox()
            .entity("{{ v.entity }}")
            .verilog_files("{{ v.rtl }}")
            .outputs("{{ v.outputs }}")
            .area({{ v.area }})
            {{ v.timing }}
            .end();
    }
};
{% endfor %}
#else
#include "{{ impl }}"
#endif

#endif /* _{{ kernel | upper }}_BLACKBOX_H_ */
