#ifndef _{{ kernel | upper }}_BLACKBOX_H_
#define _{{ kernel | upper }}_BLACKBOX_H_

#if defined(__SYNTHESIS__) && defined(BLACKBOX_FLOW)

#include <ac_int.h>
#include <ac_blackbox.h>
#include "params.h"

// A caller sees the implementation's own interface, so this declares the same
// template and the same run. The widths are the ones the packaged RTL was
// built with, since the implementation derives them from itself.
template<{{ template_decl | join(', ') }}>
class {{ kernel }}_impl {
public:
    {{ kernel }}_impl() {}

    #pragma hls_design interface ccore blackbox
    void run(
{% for p in params %}        {{ p.type }} {{ "&" if p.is_output }}{{ p.name }}{{ "," if not loop.last }}
{% endfor %}    ) {
        ac_blackbox()
            .entity("{{ entity }}")
            .verilog_files("{{ rtl }}")
            .outputs("{{ outputs }}")
            .area({{ area }})
            {{ timing }}
            .end();
    }
};

#else
#include "{{ impl }}"
#endif

#endif /* _{{ kernel | upper }}_BLACKBOX_H_ */
