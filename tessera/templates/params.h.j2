#ifndef PARAMS_H
#define PARAMS_H

#include <ac_int.h>

// Enums
{% for name, value in enums.items() -%}
#define {{ name }} {{ value }}
{% endfor %}
// Parameters
{% for name, value in params.items() -%}
#define {{ name }} {{ value }}
{% endfor %}
// Structs
{# A struct is a dict: an int is a constexpr, "val" a hex constant
   VALUE() of width "w", a dict a nested struct. Nothing else renders. #}
{% macro struct(name, s) %}
struct {{ name | norm_to_cpp_conv }} {
{% for k, v in s.items() %}
{% if v is mapping %}
    {{ struct(k, v) | indent(4) }}
{% elif k == "val" %}
    static ac_int<{{ s.w }}, false> VALUE() {
        ac_int<{{ s.w }}, false> v;
        v.bit_fill_hex("{{ v }}");
        return v;
    }
{% elif v is integer %}
    static constexpr int {{ k | norm_to_cpp_conv }} = {{ v | norm_to_cpp_conv }};
{% else %}
#error "unsupported entry {{ k }} in struct {{ name }}"
{% endif %}
{% endfor %}
};
{%- endmacro %}
{% for name, s in structs.items() %}
{{ struct(name, s) }}
{% endfor %}
{% for name, ref in usings.items() -%}
using {{ name }} = {{ ref }};
{% endfor %}
#endif // PARAMS_H
