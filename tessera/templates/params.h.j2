#ifndef PARAMS_H
#define PARAMS_H

#include <ac_int.h>

// Enums
{% for name, value in enums.items() -%}
#define {{ name }} {{ value }}
{% endfor %}
// Parameters
{% for name, value in params.items() -%}
#define {{ name }} {{ value }}
{% endfor %}
{% if fields %}
{% for f in fields %}
struct {{ f.name }} {
    static constexpr int W = {{ f.bitwidth }};
    static ac_int<{{ f.bitwidth }}, false> Q() {
        ac_int<{{ f.bitwidth }}, false> q;
        q.bit_fill_hex("{{ f.q }}");
        return q;
    }
};
{% endfor %}
using FIELD = {{ fields[0].name }};
{% endif %}
#endif // PARAMS_H
