#ifndef PARAMS_H
#define PARAMS_H

#include <ac_int.h>

// Enums
{% for name, value in enums.items() -%}
#define {{ name }} {{ value }}
{% endfor %}
// Parameters
{% for name, value in params.items() -%}
#define {{ name }} {{ value }}
{% endfor %}
{% if fields %}
// Field descriptors. Q() is a compile time constant, so a fixed modulus
// folds into the logic instead of costing a full width operand.
{% for f in fields %}
struct {{ f.name }} {
    static constexpr int W = {{ f.bitwidth }};
    static ac_int<{{ f.bitwidth }}, false> Q() {
        return ac_int<{{ f.bitwidth }}, false>("0x{{ f.q }}");
    }
};
{% endfor %}
using FIELD = {{ fields[0].name }};
{% endif %}
#endif // PARAMS_H
