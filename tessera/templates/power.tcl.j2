set power_enable_analysis true
set power_analysis_mode time_based

set_host_options -max_cores {{ max_cores }}
set link_library "* {{ target_library }}"

read_verilog {{ netlist }}
link_design {{ module }}

read_sdc {{ sdc }}
update_timing

read_vcd {{ vcd }} -zero_delay -strip_path {{ dut_path }}

{% if clock -%}
set_power_analysis_options -cycle_accurate_clock {{ clock }}
{% endif -%}
update_power
report_switching_activity -list_not_annotated -show_pin > annotation.rpt
report_power > power.rpt
report_power -verbose -hier -nosplit -sort_by name > power.hier.rpt
exit
